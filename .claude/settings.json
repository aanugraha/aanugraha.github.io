{
  "permissions": {
    "allow": [
      "Bash(set -e)",
      "Bash(git rm *)",
      "Bash(convert -version)",
      "Bash(JEKYLL_ENV=production bundle exec jekyll build)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(nohup bundle exec jekyll serve --skip-initial-build --no-watch --detach --host 0.0.0.0 --port 4000)",
      "Read(//tmp/**)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://localhost:4000/)",
      "Bash(pkill -f jekyll)",
      "Bash(curl -s -o /dev/null -w \"localhost:4000/cv/ -> HTTP %{http_code}\\\\n\" http://localhost:4000/cv/)"
    ]
  }
}
